# Copy this file to .env and change values as needed.
# .env is ignored by git. In GitHub Actions these come from repo variables/secrets.

BASE_URL=http://jupiter.cloud.planittesting.com

HEADLESS=true
RETRIES=0
WORKERS=2

# contact form takes a few seconds to "send" before the success message shows
SUBMIT_TIMEOUT=60000

# test case 2 has to be run 5 times
CONTACT_RUNS=5
